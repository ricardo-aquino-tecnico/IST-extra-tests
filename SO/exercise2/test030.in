# EXERCISE: 2
# APP: {"name": "SIGNAL", "content": true, "copy": "/tmp/CloudIST/@RESERV000000@/@RESERV000000@_1", "signal": 15, "sleep_ms": 80}
# APP: {"name": "AFTER", "content": true, "copy": "/tmp/CloudIST/@RESERV000001@/@RESERV000001@_1", "sleep_ms": 80}
# ASSERT: {"kind": "executions", "counts": {"SIGNAL": 1, "AFTER": 1}}
