# EXERCISE: 2
# APP: {"name": "FAILS", "content": true, "copy": "/tmp/CloudIST/@RESERV000000@/@RESERV000000@_1", "exit": 7, "sleep_ms": 80}
# APP: {"name": "NEXT", "content": true, "copy": "/tmp/CloudIST/@RESERV000001@/@RESERV000001@_1", "sleep_ms": 80}
# ASSERT: {"kind": "executions", "counts": {"FAILS": 1, "NEXT": 1}}
# ASSERT: {"kind": "processes"}
# ASSERT: {"kind": "before_exec"}
# ASSERT: {"kind": "snapshot", "used": [[0, 0, 0], [0, 0, 0]], "reservations": 0}
# ALLOW_EXIT: [0, 1, 7]
# COPY: @INPUT@ -> @RESERV000000@/@RESERV000000@_1
# COPY: @INPUT@ -> @RESERV000001@/@RESERV000001@_1
# FILE: 00000000.conf
D FAILS @INPUT@ @APP_FAILS@ 1 1 1
# FILE: 00000001.conf
D NEXT @INPUT@ @APP_NEXT@ 1 1 1
# FILE: 00000002.conf
R @RESERV000000@ FAILS 1 1
# FILE: 00000003.conf
A @RESERV000000@
# FILE: 00000004.conf
E 100
# FILE: 00000005.conf
R @RESERV000001@ NEXT 1 2
# FILE: 00000006.conf
A @RESERV000001@
# FILE: 00000007.conf
E 500
L
